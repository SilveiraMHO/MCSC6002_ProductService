{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Password from .env via docker-compose.
    "DefaultConnection": "Server=sqlserver,1433;Database=MCSC6002_ProductDB;User Id=sa;Encrypt=True;TrustServerCertificate=True;"
  },
  "TokenSettings": {
    "PublicKeyPath": "/keys/jwt-public.pem"
  },
  "MutualTls": {
    "ServerCertificatePath": "/keys/product.pfx",
    "CaCertificatePath": "/keys/ca.crt",
    "AllowedClientName": "api-gateway"
  },
  "CacheSettings": {
    "DestinationUrl": "redis:6379", // With password from .env via docker-compose.
    "ApplicationName": "ProductService",
    "SlidingExpirationInMinutes": 60,
    "BypassCache": false
  },
  "RabbitMqSettings": {
    "Host": "rabbitmq",
    "Port": 5671, // TLS only.
    "ServerName": "rabbitmq",
    "CaCertificatePath": "/keys/ca.crt",
    "UserName": "", // From .env via docker-compose.
    "Password": "",
    "SigningKey": "" // From .env via docker-compose.
  },
  "AllowedHosts": "*"
}
